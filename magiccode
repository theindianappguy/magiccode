#!/usr/bin/env node
"use strict";

// magiccode — a coding agent that runs on your machine
// https://github.com/theindianappguy/magiccode

const fs = require("fs");
const path = require("path");
const readline = require("readline");
const { spawnSync } = require("child_process");
const os = require("os");

const VERSION = "0.3.1";
const HOST = (process.env.OLLAMA_HOST || "http://127.0.0.1:11434").replace(/\/$/, "");
const MAX_STEPS = 16;
const MAX_READ = 60_000;   // chars returned from a single read_file
const MAX_FILES = 400;
const VERSION_URL = "https://magiccode.iag.workers.dev/version";
const RAW_URL = "https://raw.githubusercontent.com/theindianappguy/magiccode/master/magiccode";
const STATE_DIR = path.join(os.homedir(), ".magiccode");
const CHECK_FILE = path.join(STATE_DIR, "update-check.json");
const CHECK_EVERY = 24 * 60 * 60 * 1000;

// ── palette ────────────────────────────────────────────────────────────────
const tty = process.stdout.isTTY && !process.env.NO_COLOR;
const c = (code) => (s) => (tty ? `\x1b[${code}m${s}\x1b[0m` : String(s));
const amber = c("38;2;255;149;0");
const white = c("38;2;236;236;243");
const haze  = c("38;2;139;139;153");
const mint  = c("38;2;62;207;142");
const red   = c("38;2;255;123;114");

// ── banner ─────────────────────────────────────────────────────────────────
function banner(model, latest) {
  const cwd = process.cwd().replace(os.homedir(), "~");
  const engine = model ? `Ollama · ${model}` : "Ollama";
  console.log();
  console.log(` ${white("████████")}  ${white("magiccode")} ${haze("v" + VERSION)}`);
  console.log(` ${white("██")} ${amber("██")} ${white("██")}  ${haze(engine)}`);
  console.log(` ${white("██")} ${amber("██")} ${white("██")}  ${haze(cwd)}`);
  if (latest && newer(latest, VERSION)) {
    console.log(`\n  ${amber("update available")} ${haze(VERSION + " → " + latest)}  ${haze("run")} ${white("magiccode update")}`);
  }
  console.log();
}

function help() {
  console.log(`Usage: magiccode "what you want changed"

Commands:
  magiccode                Open the prompt (same as chat)
  magiccode chat           Open the prompt explicitly
  magiccode "<request>"    One-shot: ask and exit
  magiccode models         List the models Ollama has pulled
  magiccode update         Update to the latest version
  magiccode help           Show this message

Environment:
  MAGICCODE_MODEL   Model to use (default: first model Ollama lists)
  MAGICCODE_YES     Set to 1 to approve every edit without asking
  OLLAMA_HOST       Default http://127.0.0.1:11434

Examples:
  magiccode "add rate limiting to the /upload route"
  magiccode "why does the webhook retry forever?"`);
}

// ── ollama ─────────────────────────────────────────────────────────────────
async function ollama(pathname, body) {
  const res = await fetch(HOST + pathname, {
    method: body ? "POST" : "GET",
    headers: { "content-type": "application/json" },
    body: body ? JSON.stringify(body) : undefined,
  });
  if (!res.ok) throw new Error(`ollama ${res.status}: ${(await res.text()).slice(0, 300)}`);
  return res.json();
}

async function listModels() {
  try {
    const { models } = await ollama("/api/tags");
    return (models || []).map((m) => m.name);
  } catch {
    return null; // ollama unreachable
  }
}

// ── workspace helpers ──────────────────────────────────────────────────────
const SKIP_DIR = new Set([
  ".git", "node_modules", ".next", ".open-next", ".wrangler", "dist", "build",
  ".venv", "venv", "__pycache__", ".cache", "vendor", "target", ".DS_Store",
]);
const SKIP_EXT = new Set([
  ".png", ".jpg", ".jpeg", ".gif", ".webp", ".ico", ".pdf", ".zip", ".gz",
  ".mp4", ".mov", ".mp3", ".wav", ".woff", ".woff2", ".ttf", ".otf", ".lock",
]);

function walk(dir, root, out) {
  if (out.length >= MAX_FILES) return out;
  let entries;
  try { entries = fs.readdirSync(dir, { withFileTypes: true }); } catch { return out; }
  for (const e of entries) {
    if (out.length >= MAX_FILES) break;
    if (e.name.startsWith(".") && e.name !== ".gitignore") continue;
    if (SKIP_DIR.has(e.name)) continue;
    const full = path.join(dir, e.name);
    if (e.isDirectory()) walk(full, root, out);
    else if (!SKIP_EXT.has(path.extname(e.name).toLowerCase())) {
      out.push(path.relative(root, full));
    }
  }
  return out;
}

// keep every path inside the directory magiccode was invoked from
function safeResolve(rel) {
  const root = process.cwd();
  const full = path.resolve(root, rel);
  if (full !== root && !full.startsWith(root + path.sep)) {
    throw new Error(`refusing to touch a path outside ${root}`);
  }
  return full;
}

function diff(before, after, label) {
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "magiccode-"));
  const a = path.join(tmp, "before"), b = path.join(tmp, "after");
  fs.writeFileSync(a, before);
  fs.writeFileSync(b, after);
  const r = spawnSync("git", [
    "diff", "--no-index", tty ? "--color=always" : "--no-color",
    "--src-prefix=old/", "--dst-prefix=new/", "--", a, b,
  ], { encoding: "utf8" });
  fs.rmSync(tmp, { recursive: true, force: true });
  const body = (r.stdout || "").split("\n").slice(4).join("\n").trim();
  if (body) return body;
  // git missing — fall back to a blunt line count
  const bl = before.split("\n").length, al = after.split("\n").length;
  return `${label}: ${bl} lines → ${al} lines`;
}

let rl = null;
function ask(question) {
  if (process.env.MAGICCODE_YES === "1") {
    console.log(question + amber("y (MAGICCODE_YES)"));
    return Promise.resolve(true);
  }
  if (!process.stdin.isTTY) return Promise.resolve(false);
  rl = rl || readline.createInterface({ input: process.stdin, output: process.stdout });
  return new Promise((resolve) =>
    rl.question(question, (a) => resolve(/^y(es)?$/i.test(a.trim())))
  );
}

