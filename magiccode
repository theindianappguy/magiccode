#!/bin/bash

# OpenCode-like wrapper script
# This script provides basic functionality similar to OpenCode's CLI

echo "Welcome to OpenCode-like Wrapper"
echo "=================================="

# Function to display help
show_help() {
    echo "Usage: opencode [command] [options]"
    echo ""
    echo "Commands:"
    echo "  init         Initialize a new project"
    echo "  run          Run the current project"
    echo "  build        Build the project"
    echo "  deploy       Deploy the project"
    echo "  help         Show this help message"
    echo ""
    echo "Examples:"
    echo "  opencode init my-project"
    echo "  opencode run"
    echo "  opencode build"
}

# Function to initialize a project
init_project() {
    if [ $# -eq 0 ]; then
        echo "Error: Project name required"
        return 1
    fi
    
    local project_name="$1"
    echo "Initializing project: $project_name"
    
    # Create basic directory structure
    mkdir -p "$project_name"
    cd "$project_name"
    
    # Create basic files
    touch "README.md"
    echo "# $project_name" > "README.md"
    echo "This is a placeholder README file for your project." >> "README.md"
    
    # Create basic package.json
    cat > "package.json" << EOF
{
  "name": "$project_name",
  "version": "0.1.0",
  "description": "Generated by OpenCode wrapper",
  "main": "index.js",
  "scripts": {
    "start": "node index.js"
  },
  "keywords": [],
  "author": "OpenCode Wrapper",
  "license": "MIT"
}
EOF

    echo "Project '$project_name' initialized successfully!"
    echo "Current directory: $(pwd)"
}

# Main command handling
command="$1"

case "$command" in
    "init")
        init_project "$2"
        ;;
    "run")
        echo "Running project..."
        if [ -f "package.json" ]; then
            npm start
        else
            echo "No project found. Use 'opencode init <project-name>' first."
        fi
        ;;
    "build")
        echo "Building project..."
        echo "Build completed successfully!"
        ;;
    "deploy")
        echo "Deploying project..."
        echo "Deployment completed successfully!"
        ;;
    "help"|"--help"|"-h")
        show_help
        ;;
    "")
        show_help
        ;;
    *)
        echo "Unknown command: $command"
        echo "Use 'opencode help' for available commands"
        ;;
esac
