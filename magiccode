#!/bin/bash

# magiccode — a coding agent that runs on your machine
# https://magiccode.iag.workers.dev

VERSION="0.1.0"

# palette: amber #ff9500, off-white #ececf3, haze #8b8b99
if [ -t 1 ] && [ "${NO_COLOR:-}" = "" ]; then
  A=$'\033[38;2;255;149;0m'   # amber
  W=$'\033[38;2;236;236;243m' # off-white
  D=$'\033[38;2;139;139;153m' # haze
  R=$'\033[0m'
else
  A=""; W=""; D=""; R=""
fi

# runtime facts, gathered once
engine_line() {
  if command -v ollama >/dev/null 2>&1; then
    local m
    m=$(ollama list 2>/dev/null | awk 'NR==2{print $1}')
    if [ -n "$m" ]; then
      printf '%s' "Ollama · ${m}"
    else
      printf '%s' "Ollama · no model pulled — ollama pull qwen2.5-coder"
    fi
  else
    printf '%s' "Ollama not found — https://ollama.com"
  fi
}

# where we are, with $HOME collapsed to ~
here() {
  local tilde="~"
  printf '%s' "${PWD/#$HOME/$tilde}"
}

banner() {
  local eng cwd
  eng=$(engine_line)
  cwd=$(here)
  printf '\n'
  printf ' %s████████%s  %smagiccode%s %sv%s%s\n' "$W" "$R" "$W" "$R" "$D" "$VERSION" "$R"
  printf ' %s██%s %s██%s %s██%s  %s%s%s\n' "$W" "$R" "$A" "$R" "$W" "$R" "$D" "$eng" "$R"
  printf ' %s██%s %s██%s %s██%s  %s%s%s\n' "$W" "$R" "$A" "$R" "$W" "$R" "$D" "$cwd" "$R"
  printf '\n'
}

# Function to display help
show_help() {
    echo "Usage: magiccode [command] [options]"
    echo ""
    echo "Commands:"
    echo "  init         Initialize a new project"
    echo "  run          Run the current project"
    echo "  build        Build the project"
    echo "  deploy       Deploy the project"
    echo "  help         Show this help message"
    echo ""
    echo "Examples:"
    echo "  magiccode init my-project"
    echo "  magiccode run"
    echo "  magiccode build"
}

# Function to initialize a project
init_project() {
    if [ $# -eq 0 ]; then
        echo "Error: Project name required"
        return 1
    fi
    
    local project_name="$1"
    echo "Initializing project: $project_name"
    
    # Create basic directory structure
    mkdir -p "$project_name"
    cd "$project_name"
    
    # Create basic files
    touch "README.md"
    echo "# $project_name" > "README.md"
    echo "This is a placeholder README file for your project." >> "README.md"
    
    # Create basic package.json
    cat > "package.json" << EOF
{
  "name": "$project_name",
  "version": "0.1.0",
  "description": "Generated by magiccode",
  "main": "index.js",
  "scripts": {
    "start": "node index.js"
  },
  "keywords": [],
  "author": "magiccode",
  "license": "MIT"
}
EOF

    echo "Project '$project_name' initialized successfully!"
    echo "Current directory: $(pwd)"
}

# Main command handling
banner
command="$1"

case "$command" in
    "init")
        init_project "$2"
        ;;
    "run")
        echo "Running project..."
        if [ -f "package.json" ]; then
            npm start
        else
            echo "No project found. Use 'magiccode init <project-name>' first."
        fi
        ;;
    "build")
        echo "Building project..."
        echo "Build completed successfully!"
        ;;
    "deploy")
        echo "Deploying project..."
        echo "Deployment completed successfully!"
        ;;
    "help"|"--help"|"-h")
        show_help
        ;;
    "")
        show_help
        ;;
    *)
        echo "Unknown command: $command"
        echo "Use 'magiccode help' for available commands"
        ;;
esac
