// show a diff, ask, and only then touch the disk
async function proposeWrite(full, before, afterRaw, label) {
  // don't silently strip a file's trailing newline
  let after = afterRaw;
  if (before.endsWith("\n") && after.length && !after.endsWith("\n")) after += "\n";

  if (before === after) return "no change — file already matches";
  console.log(`\n  ${haze("▸ edit")} ${label}\n`);
  console.log(diff(before, after, label));
  console.log();
  const ok = await ask(`  ${amber("apply this change?")} [y/N] `);
  if (!ok) {
    console.log(`  ${red("✗ skipped")}\n`);
    return "the user rejected this edit — do not retry it, ask them what they would prefer";
  }
  fs.mkdirSync(path.dirname(full), { recursive: true });
  fs.writeFileSync(full, after);
  console.log(`  ${mint("✓ written")}\n`);
  return `wrote ${label}`;
}

async function runTool(name, args) {
  if (name === "list_files") {
    const files = walk(process.cwd(), process.cwd(), []);
    console.log(`  ${haze("▸ list")} ${files.length} files`);
    return files.join("\n") || "(no files)";
  }

  if (name === "read_file") {
    const full = safeResolve(args.path);
    if (!fs.existsSync(full)) return `error: ${args.path} does not exist`;
    const body = fs.readFileSync(full, "utf8");
    console.log(`  ${haze("▸ read")} ${args.path}`);
    return body.length > MAX_READ ? body.slice(0, MAX_READ) + "\n…(truncated)" : body;
  }

  if (name === "write_file") {
    const full = safeResolve(args.path);
    const before = fs.existsSync(full) ? fs.readFileSync(full, "utf8") : "";
    return proposeWrite(full, before, args.content ?? "", args.path);
  }

  if (name === "edit_file") {
    const full = safeResolve(args.path);
    if (!fs.existsSync(full)) return `error: ${args.path} does not exist — use write_file to create it`;
    const before = fs.readFileSync(full, "utf8");
    const { old_string, new_string } = args;
    if (typeof old_string !== "string" || old_string === "") return "error: old_string is required";
    const hits = before.split(old_string).length - 1;
    if (hits === 0) {
      return `error: old_string was not found in ${args.path}. Read the file again and copy the snippet exactly, including indentation.`;
    }
    if (hits > 1) {
      return `error: old_string appears ${hits} times in ${args.path}. Include more surrounding lines so it matches only once.`;
    }
    return proposeWrite(full, before, before.replace(old_string, new_string ?? ""), args.path);
  }

  if (name === "run_command") {
    console.log(`\n  ${haze("▸ run")} ${args.command}`);
    const ok = await ask(`  ${amber("run it?")} [y/N] `);
    if (!ok) {
      console.log(`  ${red("✗ skipped")}\n`);
      return "the user declined to run this command";
    }
    const r = spawnSync(args.command, { shell: true, encoding: "utf8", cwd: process.cwd() });
    const out = ((r.stdout || "") + (r.stderr || "")).slice(0, 8000);
    console.log(out.trim() ? out.trim() + "\n" : `  ${haze("(no output)")}\n`);
    return `exit ${r.status}\n${out}`;
  }

  return `error: unknown tool ${name}`;
}



// ── updates ────────────────────────────────────────────────────────────────
const newer = (a, b) => {                       // is a newer than b?
  const pa = String(a).split(".").map(Number), pb = String(b).split(".").map(Number);
  for (let i = 0; i < 3; i++) {
    if ((pa[i] || 0) > (pb[i] || 0)) return true;
    if ((pa[i] || 0) < (pb[i] || 0)) return false;
  }
  return false;
};

// The banner reads whatever we already know — never the network, so startup
// is instant. A refresh runs in the background and lands in time for the next
// run. A fresh install has no cache and shows nothing, which is correct: it
// is already the newest version.
function cachedVersion() {
  try { return JSON.parse(fs.readFileSync(CHECK_FILE, "utf8")).latest || null; }
  catch { return null; }
}

// Hand the lookup to a detached child, so an in-flight request can never hold
// this process open. Costs one process spawn a day.
function refreshVersion() {
  try {
    const c = JSON.parse(fs.readFileSync(CHECK_FILE, "utf8"));
    if (Date.now() - c.t < CHECK_EVERY) return;        // checked recently
  } catch {}
  try {
    const { spawn } = require("child_process");
    spawn(process.execPath, [__filename, "__refresh-version"], {
      detached: true,
      stdio: "ignore",
    }).unref();
  } catch {}
}

// the detached child: fetch, write, exit. Never prints, never fails loudly.
async function refreshVersionNow() {
  try {
    const res = await fetch(VERSION_URL, { signal: AbortSignal.timeout(8000) });
    const { version } = await res.json();
    if (!version) return;
    fs.mkdirSync(STATE_DIR, { recursive: true });
    fs.writeFileSync(CHECK_FILE, JSON.stringify({ t: Date.now(), latest: version }));
  } catch {}                                           // offline is not an error
}

// where this script actually lives, following any symlink
function installedAt() {
  try { return fs.realpathSync(process.argv[1]); } catch { return process.argv[1]; }
}

// running out of a git checkout? then git is the update mechanism, not us
function checkoutRoot(file) {
  let dir = path.dirname(file);
  for (let i = 0; i < 8; i++) {
    if (fs.existsSync(path.join(dir, ".git"))) return dir;
    const up = path.dirname(dir);
    if (up === dir) break;
    dir = up;
  }
  return null;
}

async function update() {
  const target = installedAt();
  const repo = checkoutRoot(target);
  if (repo) {
    console.log(`  ${haze("this copy is a git checkout:")} ${repo.replace(os.homedir(), "~")}`);
    console.log(`  ${haze("update it with:")}  ${white("git -C " + repo.replace(os.homedir(), "~") + " pull")}\n`);
    return;
  }
  console.log(`  ${haze("updating")} ${target.replace(os.homedir(), "~")}`);
  let body, lastErr;
  for (let attempt = 0; attempt < 3 && body === undefined; attempt++) {
    if (attempt) await new Promise((r) => setTimeout(r, 400 * attempt));
    try {
      const res = await fetch(RAW_URL, { signal: AbortSignal.timeout(15000) });
      if (!res.ok) throw new Error(`github returned ${res.status}`);
      body = await res.text();
    } catch (err) { lastErr = err; }
  }
  if (body === undefined) {
    console.error(`  ${red("✗")} could not download: ${lastErr.message}\n`);
    process.exitCode = 1;
    return;
  }
  const found = body.match(/VERSION\s*=\s*"([^"]+)"/);
  if (!found || !body.startsWith("#!")) {
    console.error(`  ${red("✗")} that download does not look like magiccode — leaving your copy alone\n`);
    process.exitCode = 1;
    return;
  }
  if (found[1] === VERSION) { console.log(`  ${mint("✓")} already on ${VERSION}\n`); return; }
  fs.writeFileSync(target + ".tmp", body, { mode: 0o755 });
  fs.renameSync(target + ".tmp", target);
  try { fs.rmSync(CHECK_FILE, { force: true }); } catch {}
  console.log(`  ${mint("✓")} ${VERSION} → ${found[1]}\n`);
}

// ── interactive prompt ─────────────────────────────────────────────────────
// Claude Code uses Ink (React + yoga) and opencode uses OpenTUI (solid).
// Both come down to the same four moves, which need no dependency at all:
// raw mode for per-keystroke input, redraw in place by walking the cursor
// back up, box-drawing characters for the frame, and hiding the real cursor
// so we can draw our own.
function readPrompt() {
  return new Promise((resolve) => {
    const stdin = process.stdin;
    const out = process.stdout;
    const cols = () => Math.max(28, out.columns || 80);
    let buf = "";
    let drawn = 0;

    const wrap = (text, w) => {
      if (!text) return [""];
      const lines = [];
      for (let i = 0; i < text.length; i += w) lines.push(text.slice(i, i + w));
      return lines;
    };

    function render() {
      const w = cols();
      const inner = w - 4;                       // "| " + text + " |"
      const lines = wrap(buf, inner);
      const bar = "─".repeat(w - 2);

      if (drawn) out.write(`\x1b[${drawn}A\x1b[0J`);   // back to the top, wipe

      let s = haze("┌" + bar + "┐") + "\n";
      lines.forEach((line, i) => {
        const lead = i === 0 ? amber("> ") : "  ";
        const caret = i === lines.length - 1 ? amber("▌") : "";
        const used = 2 + line.length + (caret ? 1 : 0);
        s += haze("│") + " " + lead + line + caret + " ".repeat(Math.max(0, inner - used)) + " " + haze("│") + "\n";
      });
      s += haze("└" + bar + "┘") + "\n";
      s += haze("  enter to send · ctrl+c to exit") + "\n";

      out.write(s);
      drawn = lines.length + 3;
    }

    function done(value) {
      stdin.removeListener("data", onKey);
      if (stdin.isTTY) stdin.setRawMode(false);
      stdin.pause();
      out.write("\x1b[?25h");                          // cursor back
      if (drawn) out.write(`\x1b[${drawn}A\x1b[0J`);   // clear the box away
      resolve(value);
    }

    // a chunk can be one keystroke or a whole pasted block — walk it
    function onKey(chunk) {
      const str = chunk.toString("utf8");
      let dirty = false;
      for (let i = 0; i < str.length; i++) {
        const ch = str[i];
        if (ch === "\u0003") { out.write("\n"); done(null); return; }          // ctrl+c
        if (ch === "\u0004" && buf === "") { done(null); return; }              // ctrl+d
        if (ch === "\r" || ch === "\n") {
          if (buf.trim()) { done(buf.trim()); return; }
          continue;                                                            // ignore blank enter
        }
        if (ch === "\u007f" || ch === "\b") { buf = buf.slice(0, -1); dirty = true; continue; }
        if (ch === "\u0015") { buf = ""; dirty = true; continue; }              // ctrl+u
        if (ch === "\u001b") {                                                 // skip an escape sequence
          i++;
          while (i < str.length && !/[A-Za-z~]/.test(str[i])) i++;
          continue;
        }
        if (ch === "\t" || ch >= " ") { buf += ch; dirty = true; }
      }
      if (dirty) render();
    }

    out.write("\x1b[?25l");                            // hide the real cursor
    stdin.resume();
    if (stdin.isTTY) stdin.setRawMode(true);
    stdin.on("data", onKey);
    render();
  });
}

async function chat(model) {
  const messages = [systemMessage()];
  console.log(haze("  ask for a change in this directory\n"));
  for (;;) {
    const request = await readPrompt();
    if (request === null) { console.log(haze("  bye\n")); return; }
    console.log(`  ${amber(">")} ${request}\n`);
    try {
      await agent(request, model, messages);
    } catch (err) {
      console.error(`  ${red("✗")} ${err.message}\n`);
    }
  }
}

// ── agent loop ─────────────────────────────────────────────────────────────
function systemMessage() {
  return {
    role: "system",
    content: [
        "You are magiccode, a coding agent working inside the user's project directory.",
        "Use the tools to look at real files — never guess at file contents.",
        "Always read a file before you change it. Use edit_file to change existing files — " +
        "reserve write_file for creating new ones, and pass the COMPLETE file when you do.",
        "Make the smallest change that does the job. Match the surrounding style.",
        "Do not ask the user which change to make — decide, make it, and let them approve the diff.",
      "Only ask a question if the request is genuinely impossible to act on.",
      "When you are done, reply with a short plain-English summary of what changed.",
    ].join(" "),
  };
}

async function agent(request, model, prior) {
  const messages = prior || [systemMessage()];
  messages.push({ role: "user", content: request });

  for (let step = 0; step < MAX_STEPS; step++) {
    let res;
    try {
      res = await ollama("/api/chat", { model, messages, tools: TOOLS, stream: false });
    } catch (err) {
      if (/does not support tools/i.test(err.message)) {
        console.error(`\n${red("✗")} ${model} cannot call tools, so it cannot edit files.`);
        console.error(`  Pull one that can:  ${white("ollama pull qwen2.5-coder")}\n`);
        process.exit(1);
      }
      throw err;
    }

    const msg = res.message || {};
    messages.push(msg);

    const calls = msg.tool_calls || [];
    if (calls.length === 0) {
      if (msg.content && msg.content.trim()) console.log("\n" + msg.content.trim() + "\n");
      return;
    }

    for (const call of calls) {
      const name = call.function?.name;
      let args = call.function?.arguments ?? {};
      if (typeof args === "string") { try { args = JSON.parse(args); } catch { args = {}; } }
      let result;
      try { result = await runTool(name, args); }
      catch (err) { result = `error: ${err.message}`; }
      messages.push({ role: "tool", tool_name: name, content: String(result) });
    }
  }
  console.log(haze(`\nstopped after ${MAX_STEPS} steps — run it again to continue\n`));
}

// ── entry ──────────────────────────────────────────────────────────────────
(async function main() {
  const argv = process.argv.slice(2);
  const cmd = argv[0];

  if (cmd === "__refresh-version") { await refreshVersionNow(); return; }

  if (cmd === "update") { console.log(); await update(); return; }
  if (cmd === "help" || cmd === "--help" || cmd === "-h") { refreshVersion(); banner(null, cachedVersion()); help(); return; }
  if (cmd === "version" || cmd === "--version" || cmd === "-v") { console.log(VERSION); return; }

  const latest = cachedVersion();
  refreshVersion();
  const models = await listModels();
  if (models === null) {
    banner(null, latest);
    console.error(`${red("✗")} Can't reach Ollama at ${HOST}`);
    console.error(`  Install it from ${white("https://ollama.com")}, then: ${white("ollama serve")}\n`);
    process.exit(1);
  }
  if (models.length === 0) {
    banner(null, latest);
    console.error(`${red("✗")} Ollama has no models pulled.`);
    console.error(`  Try: ${white("ollama pull qwen2.5-coder")}\n`);
    process.exit(1);
  }

  const model = process.env.MAGICCODE_MODEL || models[0];

  if (cmd === "chat") { banner(model, latest); await chat(model); return; }

  if (cmd === "models") {
    banner(model, latest);
    for (const m of models) console.log(`  ${m === model ? amber("● ") : haze("○ ")}${m}`);
    console.log();
    return;
  }

  if (!cmd) {
    banner(model, latest);
    if (process.stdin.isTTY) { await chat(model); return; }
    help();
    return;
  }

  banner(model, latest);
  try {
    await agent(argv.join(" "), model);
  } catch (err) {
    console.error(`\n${red("✗")} ${err.message}\n`);
    process.exitCode = 1;
  } finally {
    if (rl) rl.close();
  }
})();
